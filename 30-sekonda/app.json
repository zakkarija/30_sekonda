{
  "expo": {
    "name": "30 Sekonda",
    "slug": "30-sekonda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "30sekonda",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1A1A2E",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1A1A2E"
      },
      "edgeToEdgeEnabled": true,
      "package": "zikogames.tlettinsekonda"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "30 Sekonda",
      "shortName": "30 Sekonda",
      "themeColor": "#1A1A2E",
      "backgroundColor": "#1A1A2E"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1A1A2E"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8faa6f22-fab4-4464-9abc-35e355033780"
      }
    }
  }
}
